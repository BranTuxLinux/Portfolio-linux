---
import { getLangFromUrl, useTranslations, languages } from '../i18n/utils';
import { siteMetadata } from '../data/config';
import '../styles/global.css';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const siteTitle = t('site.title');
const siteDescription = t('site.description');

// Las dos rutas son la misma pagina en dos idiomas: sin hreflang, un buscador
// las trata como duplicados y decide por su cuenta cual indexar.
const rutaSinIdioma = Astro.url.pathname.replace(/^\/es(?=\/|$)/, '') || '/';
const alternativas = [
    { hreflang: 'en', href: new URL(rutaSinIdioma, siteMetadata.siteUrl).href },
    { hreflang: 'es', href: new URL(`/es${rutaSinIdioma}`.replace(/\/$/, '') + '/', siteMetadata.siteUrl).href },
];
const canonical = alternativas.find((alternativa) => alternativa.hreflang === lang)?.href;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={siteDescription} />
		<meta name="author" content={siteMetadata.author} />
		<title>{siteTitle}</title>

		<link rel="canonical" href={canonical} />
		{alternativas.map((alternativa) => (
			<link rel="alternate" hreflang={alternativa.hreflang} href={alternativa.href} />
		))}
		<link rel="alternate" hreflang="x-default" href={alternativas[0].href} />

		<meta property="og:type" content="profile" />
		<meta property="og:title" content={siteTitle} />
		<meta property="og:description" content={siteDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
		{Object.keys(languages)
			.filter((otro) => otro !== lang)
			.map((otro) => (
				<meta property="og:locale:alternate" content={otro === 'es' ? 'es_ES' : 'en_US'} />
			))}
		<meta name="twitter:card" content="summary" />
		<meta name="theme-color" content="#0f0f0f" />
	</head>
	<body class="bg-[var(--bg-color)] text-[var(--text-main)] font-['Courier_New',Courier,monospace] leading-relaxed overflow-x-hidden">
		<a href="#hero" class="skip-link">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
		<slot />
	</body>
</html>

<style>
	/* Un lector de teclado no deberia recorrer la navegacion entera para llegar
	   al contenido. El enlace existe siempre y solo se ve al enfocarlo. */
	.skip-link {
		position: absolute;
		left: -9999px;
		top: 0;
		background-color: var(--card-bg);
		color: var(--highlight);
		padding: 0.6rem 1rem;
		border: 1px solid var(--highlight);
		z-index: 50;
	}

	.skip-link:focus {
		left: 1rem;
		top: 1rem;
	}
</style>
