---
import { socialLinks } from '../../data/config';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

/** Cada enlace se declara una vez: mismo marcado, distinto destino. */
const enlaces = [
    { clave: 'cv', icono: '📄', href: t('social.cv.file'), descarga: true },
    { clave: 'linkedin', icono: '💼', href: socialLinks.linkedin, externo: true },
    { clave: 'email', icono: '✉️', href: `mailto:${socialLinks.email}` },
    { clave: 'github', icono: '🐙', href: socialLinks.github, externo: true },
    { clave: 'github2', icono: '🐙', href: socialLinks.github2, externo: true },
    { clave: 'blog', icono: '📰', href: t('social.blog.url'), externo: true, destacado: true },
    { clave: 'blogCompany', icono: '📰', href: t('social.blogCompany.url'), externo: true },
];
---

<section id="social-links" class="my-8">
    <div class="flex flex-wrap gap-3">
        {enlaces.map(({ clave, icono, href, externo, descarga, destacado }) => (
            <a
                href={href}
                download={descarga}
                target={externo ? '_blank' : undefined}
                rel={externo ? 'noopener noreferrer' : undefined}
                class:list={['social-link', destacado && 'social-link--destacado']}
                title={t(`social.${clave}.title`)}
            >
                <span class="icon" aria-hidden="true">{icono}</span>
                <span class="command">{t(`social.${clave}.command`)}</span>
                <span class="status">{t(`social.${clave}.status`)}</span>
            </a>
        ))}
    </div>
</section>

<style>
    .social-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1rem;
        background-color: var(--card-bg);
        border: 1px solid var(--border);
        color: var(--text-main);
        text-decoration: none;
        font-family: 'Courier New', monospace;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        position: relative;
        overflow: hidden;
    }

    /* El blog propio es el enlace que se quiere que abran: se marca. */
    .social-link--destacado {
        border-color: var(--arch-red);
    }

    .social-link--destacado .command {
        color: var(--arch-teal);
    }

    .social-link::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        width: 3px;
        background-color: var(--arch-red);
        transform: scaleY(0);
        transition: transform 0.2s ease;
    }

    .social-link:hover {
        border-color: var(--highlight);
        transform: translateX(3px);
        background-color: var(--card-bg-hover);
    }

    .social-link:hover::before {
        transform: scaleY(1);
    }

    .social-link .icon {
        font-size: 1.2rem;
        filter: grayscale(0.3);
        transition: filter 0.2s ease;
    }

    .social-link:hover .icon {
        filter: grayscale(0);
    }

    .social-link .command {
        transition: color 0.2s ease;
    }

    .social-link:hover .command {
        color: var(--highlight);
    }

    .social-link .status {
        color: var(--text-dim);
        font-size: 0.75rem;
        font-weight: bold;
        margin-left: 0.25rem;
        transition: color 0.2s ease;
    }

    .social-link:hover .status {
        color: #ff5555;
    }

    @media (max-width: 640px) {
        .social-link {
            font-size: 0.75rem;
            padding: 0.5rem 0.8rem;
        }

        .social-link .icon {
            font-size: 1rem;
        }

        .social-link .status {
            display: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .social-link,
        .social-link:hover {
            transform: none;
        }
    }
</style>
