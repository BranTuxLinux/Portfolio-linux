---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import JobCard from '../ui/JobCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const jobs = ['job1', 'job2', 'job3', 'job4', 'job5'];
---

<section id="experience" class="mb-14 scroll-mt-8">
    <h2 class="section-title">{t('experience.title')}</h2>

    <div class="grid grid-cols-1 gap-5">
        {jobs.map((jobKey) => {
            const job = t(`jobs.${jobKey}`);
            return (
                <JobCard
                    id={`job-${jobKey}`}
                    title={job.title}
                    company={job.company}
                    period={job.period}
                    technologies={job.technologies}
                >
                    {job.description.map((paragraph: string) => (
                        <p set:html={paragraph} class="mb-2" />
                    ))}
                </JobCard>
            );
        })}
    </div>
</section>

